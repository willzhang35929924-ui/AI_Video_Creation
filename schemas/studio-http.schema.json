{
  "StudioProductReferencePlan": {
    "additionalProperties": false,
    "properties": {
      "product_id": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Product Id",
        "type": "string"
      },
      "image_ids": {
        "items": {
          "type": "string"
        },
        "maxItems": 4,
        "minItems": 1,
        "title": "Image Ids",
        "type": "array"
      },
      "selection_reason": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Selection Reason",
        "type": "string"
      }
    },
    "required": [
      "product_id",
      "image_ids",
      "selection_reason"
    ],
    "title": "StudioProductReferencePlan",
    "type": "object"
  },
  "PipelineStart": {
    "$defs": {
      "MotionReferenceInput": {
        "additionalProperties": false,
        "description": "An explicit, per-shot permission to use a bounded source segment.",
        "properties": {
          "video_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Video Id",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 1,
            "title": "Expected Revision",
            "type": "integer"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Source Sha256",
            "type": "string"
          },
          "trim_start_seconds": {
            "minimum": 0,
            "title": "Trim Start Seconds",
            "type": "number"
          },
          "trim_end_seconds": {
            "exclusiveMinimum": 0,
            "title": "Trim End Seconds",
            "type": "number"
          },
          "authorized_for_motion": {
            "title": "Authorized For Motion",
            "type": "boolean"
          },
          "reference_role": {
            "anyOf": [
              {
                "enum": [
                  "structure",
                  "action"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reference Role"
          },
          "target_character_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Character Id"
          }
        },
        "required": [
          "video_id",
          "expected_revision",
          "source_sha256",
          "trim_start_seconds",
          "trim_end_seconds",
          "authorized_for_motion"
        ],
        "title": "MotionReferenceInput",
        "type": "object"
      },
      "QualitySettings": {
        "additionalProperties": false,
        "properties": {
          "resolution": {
            "default": "720p",
            "enum": [
              "720p",
              "1080p",
              "2k",
              "4k"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "mode": {
            "default": "high",
            "enum": [
              "high",
              "standard",
              "fast",
              "preview"
            ],
            "title": "Mode",
            "type": "string"
          },
          "aspect_ratio": {
            "default": "16:9",
            "enum": [
              "16:9",
              "9:16",
              "1:1"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "processing": {
            "default": "lanczos",
            "enum": [
              "lanczos",
              "native",
              "ai_super_resolution",
              "seedvr2",
              "reconstruction"
            ],
            "title": "Processing",
            "type": "string"
          }
        },
        "title": "QualitySettings",
        "type": "object"
      },
      "StudioProductReferencePlan": {
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Product Id",
            "type": "string"
          },
          "image_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Image Ids",
            "type": "array"
          },
          "selection_reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Selection Reason",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "image_ids",
          "selection_reason"
        ],
        "title": "StudioProductReferencePlan",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "dialogue_audio_policy": {
        "anyOf": [
          {
            "enum": [
              "auto",
              "native",
              "tts",
              "skip"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Dialogue Audio Policy"
      },
      "automatic_draft_assembly": {
        "default": false,
        "title": "Automatic Draft Assembly",
        "type": "boolean"
      },
      "product_reference_plan": {
        "anyOf": [
          {
            "$ref": "#/$defs/StudioProductReferencePlan"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "quality": {
        "anyOf": [
          {
            "$ref": "#/$defs/QualitySettings"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "allow_cloud_costs": {
        "default": false,
        "title": "Allow Cloud Costs",
        "type": "boolean"
      },
      "allow_paid_fallback": {
        "default": false,
        "title": "Allow Paid Fallback",
        "type": "boolean"
      },
      "width": {
        "default": 1024,
        "maximum": 3840,
        "minimum": 256,
        "multipleOf": 8,
        "title": "Width",
        "type": "integer"
      },
      "height": {
        "default": 576,
        "maximum": 3840,
        "minimum": 256,
        "multipleOf": 8,
        "title": "Height",
        "type": "integer"
      },
      "shot_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Shot Ids"
      },
      "prompt_overrides": {
        "additionalProperties": {
          "minLength": 1,
          "type": "string"
        },
        "title": "Prompt Overrides",
        "type": "object"
      },
      "reference_image_ids": {
        "additionalProperties": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 9,
          "type": "array"
        },
        "title": "Reference Image Ids",
        "type": "object"
      },
      "motion_reference_overrides": {
        "additionalProperties": {
          "items": {
            "$ref": "#/$defs/MotionReferenceInput"
          },
          "maxItems": 3,
          "type": "array"
        },
        "title": "Motion Reference Overrides",
        "type": "object"
      },
      "max_retries": {
        "default": 2,
        "maximum": 3,
        "minimum": 0,
        "title": "Max Retries",
        "type": "integer"
      }
    },
    "title": "PipelineStart",
    "type": "object"
  },
  "DecisionInput": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "keep",
