      "instruction": {
        "default": "",
        "title": "Instruction",
        "type": "string"
      },
      "prompt_override": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Prompt Override"
      },
      "expected_revision": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Revision"
      },
      "operator": {
        "default": "local-user",
        "enum": [
          "local-user",
          "acceptance-test"
        ],
        "title": "Operator",
        "type": "string"
      }
    },
    "required": [
      "action"
    ],
    "title": "DecisionInput",
    "type": "object"
  },
  "ComposeInput": {
    "additionalProperties": false,
    "properties": {
      "expected_decisions": {
        "anyOf": [
