{
  "properties": {
    "protocol": {
      "const": "video-factory-runtime-1",
      "default": "video-factory-runtime-1",
      "title": "Protocol",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "slot": {
      "enum": [
        "script_planning",
        "character_image",
        "keyframe_image",
        "video_generation",
        "motion_driving",
        "dialogue_generation",
        "lip_sync",
        "video_upscale",
        "quality_check",
        "final_assembly",
        "screenplay_from_text",
        "screenplay_from_image",
        "screenplay_from_video"
      ],
      "title": "Slot",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "output_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Path"
    },
    "output_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "inputs_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Inputs Sha256",
      "type": "object"
    },
    "actual": {
      "additionalProperties": true,
      "title": "Actual",
      "type": "object"
    },
    "runtime": {
      "additionalProperties": true,
      "title": "Runtime",
      "type": "object"
    },
    "elapsed_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Seconds"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "task_id",
    "slot",
    "model_id",
    "status"
  ],
  "title": "RuntimeReceipt",
  "type": "object"
}
