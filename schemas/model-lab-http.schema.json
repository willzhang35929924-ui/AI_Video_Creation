  "ModelExperimentInput": {
    "$defs": {
      "ModelCaseInput": {
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "maxLength": 160,
            "title": "Label",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "model_id"
        ],
        "title": "ModelCaseInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "name": {
        "default": "视频模型对照实验",
        "maxLength": 160,
        "title": "Name",
        "type": "string"
      },
      "shot_id": {
        "title": "Shot Id",
        "type": "string"
      },
      "prompt": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Prompt"
      },
      "mode": {
        "default": "cross_model",
        "enum": [
          "cross_model",
          "parameters"
        ],
        "title": "Mode",
        "type": "string"
      },
      "seed": {
        "default": 20261020,
        "maximum": 2147483647,
        "minimum": 0,
        "title": "Seed",
        "type": "integer"
      },
      "width": {
        "default": 1024,
        "maximum": 3840,
        "minimum": 256,
        "multipleOf": 8,
        "title": "Width",
        "type": "integer"
      },
      "height": {
        "default": 576,
        "maximum": 3840,
        "minimum": 256,
        "multipleOf": 8,
        "title": "Height",
        "type": "integer"
      },
      "allow_cloud_costs": {
        "default": false,
        "title": "Allow Cloud Costs",
        "type": "boolean"
      },
      "cases": {
        "items": {
          "$ref": "#/$defs/ModelCaseInput"
        },
        "maxItems": 6,
        "minItems": 2,
        "title": "Cases",
        "type": "array"
      }
    },
    "required": [
      "shot_id",
      "cases"
    ],
    "title": "ModelExperimentInput",
    "type": "object"
  },
