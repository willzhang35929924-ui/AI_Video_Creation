# Optional: docker compose up -d works without creating this file.
# Cloud secrets belong in Settings. Never commit .env or credentials.
# Keep this project name when upgrading to retain the same named volumes.
COMPOSE_PROJECT_NAME=video-factory
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
IMPORT_MAX_MB=50

# Fallback addresses only. A saved Settings service profile takes precedence.
# Models and GPU environments are separately installed, never in the app image.
# Use host.docker.internal for a Docker Desktop host, not container localhost.
COMFYUI_BASE_URL=http://host.docker.internal:8189
H3_CONTEXT_COMFYUI_URL=http://host.docker.internal:8788

# Optional administrator origin allowlist for legacy configured local services.
# Normal users confirm the exact local service in Settings instead; no restart
# or .env edit is needed for that per-profile permission. No paths/credentials.
TRUSTED_LOCAL_SERVICE_ORIGINS=

# Optional project-specific local Qwen/Whisper screenplay factory protocol.
# This is not a generic chat API. Prefer a service profile in Settings.
LOCAL_SCREENPLAY_BASE_URL=
LOCAL_SCREENPLAY_EXPECTED_WORKSPACE=

# Set true only for a confirmed separate GPU, never to bypass shared-GPU safety.
LOCAL_LLM_GPU_INDEPENDENT=false

# Current-source build images used by the default compose.yaml.
# BACKEND_SOURCE_IMAGE=video-factory-backend:local
# FRONTEND_SOURCE_IMAGE=video-factory-frontend:local
# PYTHON_IMAGE=python:3.12-slim-bookworm
# NODE_IMAGE=node:24.22.1-alpine3.23
# NGINX_IMAGE=nginx/nginx-unprivileged:1.30.6-alpine
# APP_VERSION=source
# VCS_REF=unknown
# VCS_SOURCE=
# BUILD_DATE=
# APP_LICENSE=Apache-2.0

# Optional source-build mirrors. HTTPS, signatures and locked hashes stay on.
# DEBIAN_MIRROR=https://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
# PYPI_INDEX_URL=https://pypi.org/simple

# Only compose.prebuilt.yaml reads these optional release references.
# Verify that the published tag contains the features you need before switching.
# BACKEND_IMAGE=ghcr.io/willzhang35929924-ui/ai_video_creation-backend:latest
# FRONTEND_IMAGE=ghcr.io/willzhang35929924-ui/ai_video_creation-frontend:latest

# Standalone development: docker compose -f compose.dev.yaml up -d --build
# Its defaults are video-factory-dev / 18083; do not copy the production project
# name above into a shared .env when you intend to keep dev data isolated.
# BACKEND_DEV_IMAGE=video-factory-backend:dev
# FRONTEND_DEV_IMAGE=video-factory-frontend:dev
