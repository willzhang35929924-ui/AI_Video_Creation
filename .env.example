# Optional Docker Compose configuration. Copy to .env only when overriding defaults.
# Never commit .env. Cloud credentials belong in Settings, not in this file.
# The web UI/API is intentionally bound to this computer by default.
# Preserve the same project name across upgrades to reuse its 3 named volumes.
# For an isolated restore, choose a NEW unused name before creating containers.
COMPOSE_PROJECT_NAME=video-factory
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
IMPORT_MAX_MB=50

# Optional separately running ComfyUI. Models are NOT included in the image.
# Example only; host.docker.internal does not guarantee access to a service
# bound exclusively to the host loopback interface.
COMFYUI_BASE_URL=http://host.docker.internal:8189

# Explicit exact origin allowlist for local/private ComfyUI and local_llm only.
# Leave empty until you own/control the service. No credentials, paths or query.
# Example: TRUSTED_LOCAL_SERVICE_ORIGINS=http://host.docker.internal:8189,http://host.docker.internal:8771
TRUSTED_LOCAL_SERVICE_ORIGINS=

# Optional separately installed project Qwen/Whisper factory protocol endpoint.
# Must end in /v1 and have its exact origin in the allowlist above. Its health
# identity, model and script SHA are verified; this is not a generic API.
LOCAL_SCREENPLAY_BASE_URL=
LOCAL_SCREENPLAY_EXPECTED_WORKSPACE=

# Set true only when the configured local LLM and ComfyUI are on distinct GPUs.
# Otherwise dispatch conservatively checks and releases the shared Comfy GPU.
LOCAL_LLM_GPU_INDEPENDENT=false

# Cloud API keys are entered through the application's settings page and are
# encrypted with a generated persistent key in the app_data volume. Do not put
# secrets in this example, source control, shell history or screenshot.
# Built-in defaults can be replaced with compatible official image tags/digests:
# PYTHON_IMAGE=python:3.12-slim-bookworm
# NODE_IMAGE=node:24.22.1-alpine3.23
# NGINX_IMAGE=nginx/nginx-unprivileged:1.30.6-alpine

# Optional version pins for the confirmed GitHub repository; latest is the default.
# Use only tags/digests verified by the release workflow.
# BACKEND_IMAGE=ghcr.io/willzhang35929924-ui/ai_video_creation-backend:v0.1.0
# FRONTEND_IMAGE=ghcr.io/willzhang35929924-ui/ai_video_creation-frontend:v0.1.0

# Source builds only: docker compose -f compose.dev.yaml up -d --build
# Keep development isolated from an existing production installation.
# COMPOSE_PROJECT_NAME=video-factory-dev
# WEB_PORT=18083
# BACKEND_DEV_IMAGE=video-factory-backend:dev
# FRONTEND_DEV_IMAGE=video-factory-frontend:dev
# APP_VERSION=development
# VCS_REF=unknown
# VCS_SOURCE=
# BUILD_DATE=
# APP_LICENSE=MIT
# Optional source-build network mirrors; signatures/TLS and pinned hashes remain required.
# DEBIAN_MIRROR=https://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
# PYPI_INDEX_URL=https://pypi.org/simple
