{
  "_video_factory": {
    "id": "seedvr2_video_v1",
    "kind": "video_super_resolution",
    "method": "SeedVR2 3B FP8 native temporal video restoration",
    "temporal_model": true,
    "model_repo": "Comfy-Org/SeedVR2",
    "model_revision": "df48879708206a403d2a61acd55578c2e80fd233",
    "notes": [
      "New independent workflow; no existing H3/Klein/default settings modified.",
      "One-step Euler native restoration; 9-frame temporal chunks and tiled VAE for the 16GB candidate test.",
      "Native preprocessing pads temporal length to4n+1; postprocessing crops back to original frames and dimensions.",
      "prepare substitutes the exact input path/output prefix/target; submit is explicit and queue-gated.",
      "Collect remuxes source compressed audio to a new E delivery file and probes/fully decodes all frames.",
      "Not a human visual quality approval. Actual VRAM/runtime compatibility requires real successful execution."
    ]
  },
  "prompt": {
    "1": {"class_type": "LoadVideo", "inputs": {"file": "__INPUT_VIDEO__"}},
    "2": {"class_type": "GetVideoComponents", "inputs": {"video": ["1", 0]}},
    "3": {"class_type": "ImageScale", "inputs": {"image": ["2", 0], "upscale_method": "lanczos", "width": 1280, "height": 720, "crop": "disabled"}},
    "4": {"class_type": "SeedVR2Preprocess", "inputs": {"resized_images": ["3", 0]}},
    "5": {"class_type": "UNETLoader", "inputs": {"unet_name": "seedvr2_3b_fp8_e4m3fn.safetensors", "weight_dtype": "default"}},
    "6": {"class_type": "VAELoader", "inputs": {"vae_name": "seedvr2_ema_vae_fp16.safetensors"}},
    "7": {"class_type": "VAEEncodeTiled", "inputs": {"pixels": ["4", 0], "vae": ["6", 0], "tile_size": 512, "overlap": 64, "temporal_size": 16, "temporal_overlap": 4}},
    "8": {"class_type": "SeedVR2TemporalChunk", "inputs": {"latent": ["7", 0], "temporal_overlap": 1, "chunking_mode": "manual", "chunking_mode.frames_per_chunk": 9}},
    "9": {"class_type": "SeedVR2Conditioning", "inputs": {"model": ["5", 0], "vae_conditioning": ["8", 0]}},
    "10": {"class_type": "KSampler", "inputs": {"model": ["5", 0], "seed": 20261024, "steps": 1, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "positive": ["9", 0], "negative": ["9", 1], "latent_image": ["8", 0], "denoise": 1}},
    "11": {"class_type": "SeedVR2TemporalMerge", "inputs": {"latents": ["10", 0], "temporal_overlap": ["8", 1]}},
    "12": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["11", 0], "vae": ["6", 0], "tile_size": 512, "overlap": 64, "temporal_size": 16, "temporal_overlap": 4}},
    "13": {"class_type": "SeedVR2PostProcessing", "inputs": {"images": ["12", 0], "original_resized_images": ["3", 0], "color_correction_method": "lab"}},
    "14": {"class_type": "CreateVideo", "inputs": {"images": ["13", 0], "audio": ["2", 1], "fps": ["2", 2], "bit_depth": 8, "color_space": "sRGB", "codec": "none"}},
    "15": {"class_type": "SaveVideo", "inputs": {"video": ["14", 0], "filename_prefix": "seedvr2_tests/seedvr2_video_v1", "format": "mp4", "format.codec": "h264", "format.codec.encoding": "re-encode", "format.codec.encoding.crf": 18}}
  }
}
