{
  "kind": "comfyui",
  "schema_version": "1.0.0",
  "meta": {
    "name": "Local MiniMax H3 R2V",
    "author": "local",
    "version": "1.0.0",
    "description": "Local H3 R2V through ComfyUI 8189. Provide one reference image. Keep workflow resolution and duration unchanged for initial setup.",
    "hints": {
      "base_url": "http://host.docker.internal:8189"
    }
  },
  "media_type": "video",
  "workflow": {
    "127": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_ref2va_pruned_w6a8.safetensors",
        "weight_dtype": "default"
      }
    },
    "128": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    "119": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
      }
    },
    "120": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    },
    "137": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "ARCREEL_REFERENCE_IMAGE.png"
      }
    },
    "136": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "128",
          0
        ],
        "prompt": "Use <Picture 1> as the subject reference. Natural motion and consistent appearance.",
        "width": 640,
        "height": 384,
        "length": 124,
        "ref_image_size": "match",
        "vae": [
          "119",
          0
        ],
        "audio_vae": [
          "120",
          0
        ],
        "ref_images.ref_image_0": [
          "137",
          0
        ]
      }
    },
    "129": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 20261020
      }
    },
    "123": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "124": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "127",
          0
        ],
        "scheduler": "simple",
        "steps": 20,
        "denoise": 1.0
      }
    },
    "126": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "127",
          0
        ],
        "conditioning": [
          "136",
          0
        ]
      }
    },
    "125": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "129",
          0
        ],
        "guider": [
          "126",
          0
        ],
        "sampler": [
          "123",
          0
        ],
        "sigmas": [
          "124",
          0
        ],
        "latent_image": [
          "136",
          1
        ]
      }
    },
    "122": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "125",
          0
        ],
        "vae": [
          "119",
          0
        ]
      }
    },
    "121": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "125",
          0
        ],
        "vae": [
          "120",
          0
        ]
      }
    },
    "130": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "122",
          0
        ],
        "audio": [
          "121",
          0
        ],
        "fps": 24
      }
    },
    "92": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "130",
          0
        ],
        "filename_prefix": "ArcReel/minimax_h3_r2v",
        "format": "mp4",
        "format.codec": "h264"
      }
    }
  },
  "bindings": {
    "prompt": [
      {
        "node": "136",
        "input": "prompt",
        "class_type": "MiniMaxH3ReferenceToVideo"
      }
    ],
    "negative_prompt": [],
    "start_image": [],
    "end_image": [],
    "reference_images": [
      {
        "node": "137",
        "input": "image",
        "class_type": "LoadImage",
        "consumer": {
          "node": "136",
          "input": "ref_images.ref_image_0",
          "class_type": "MiniMaxH3ReferenceToVideo"
        }
      }
    ],
    "width": [],
    "height": [],
    "frames": [],
    "fps": [
      {
        "node": "130",
        "input": "fps",
        "class_type": "CreateVideo",
        "direction": "read"
      }
    ],
    "seed": [
      {
        "node": "129",
        "input": "noise_seed",
        "class_type": "RandomNoise",
        "policy": "random"
      }
    ],
    "output": [
      {
        "node": "92",
        "class_type": "SaveVideo"
      }
    ]
  }
}